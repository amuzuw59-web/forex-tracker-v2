# MetaApi credentials
# Replace these placeholders in your local .env file only.
METAAPI_TOKEN=your_metaapi_token_here
METAAPI_ACCOUNT_ID=your_metaapi_account_id_here

# Google OpenID Connect / Flask session
# Register this exact URI in Google Cloud Console:
# https://forex-tracker-v2.onrender.com/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
SESSION_SECRET=generate_a_long_random_value_here
# Keep true on Render HTTPS. Set false only for local HTTP development.
AUTH_COOKIE_SECURE=true
